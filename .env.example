APP_ENV=production
APP_DEBUG=false

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hache_natacion
DB_USER=hache_app
DB_PASS=CAMBIAR_EN_SERVIDOR
DB_CHARSET=utf8mb4

# Llave maestra local para cifrar credenciales de pasarelas de pago.
# Genera un valor aleatorio de al menos 32 caracteres y NO lo subas al repositorio.
HACHE_PAYMENT_CONFIG_KEY=

HACHE_ALERT_EMAIL_TO=
HACHE_RESEND_API_KEY=
HACHE_EMAIL_FROM=notificaciones@hnatacion.com
HACHE_EMAIL_FROM_NAME=Hache Natación
