APP_ENV=production
APP_DEBUG=false

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hache_natacion
DB_USER=hache_app
DB_PASS=CAMBIAR_EN_SERVIDOR
DB_CHARSET=utf8mb4

HACHE_ALERT_EMAIL_TO=
HACHE_RESEND_API_KEY=
HACHE_EMAIL_FROM=notificaciones@hnatacion.com
HACHE_EMAIL_FROM_NAME=Hache Natación

# WhatsApp Cloud API / Sharky
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_GRAPH_VERSION=v26.0
# Opcional: fija un Flow publicado existente. Si queda vacío, Sharky intenta
# encontrar/crear/publicar Hache_Sharky_Birthdate_v1 de forma idempotente.
WHATSAPP_BIRTHDATE_FLOW_ID=
# Legacy Commerce Flow v1 pins. Se conservan por compatibilidad con despliegues
# existentes, pero el runtime v2 nunca los acepta como recursos corregidos.
WHATSAPP_ENROLLMENT_FLOW_ID=
WHATSAPP_PAYMENT_METHOD_FLOW_ID=
WHATSAPP_PAYMENT_TRANSFER_FLOW_ID=
WHATSAPP_PAYMENT_CARD_FLOW_ID=
# Commerce Flow v2 pins. Déjalos vacíos para provisioning automático; si se fijan,
# deben apuntar explícitamente a los recursos Hache_Sharky_*_v2 publicados.
WHATSAPP_ENROLLMENT_FLOW_V2_ID=
WHATSAPP_PAYMENT_METHOD_FLOW_V2_ID=
WHATSAPP_PAYMENT_TRANSFER_FLOW_V2_ID=
WHATSAPP_PAYMENT_CARD_FLOW_V2_ID=
# Opcional: ruta raíz de Tienda Natación en el mismo VPS. Déjala vacía para que
# Sharky autodetecte una instalación válida por .env + clases del gateway.
HACHE_TIENDA_ROOT=

# Sharky 2.0: permanece apagado hasta ejecutar migración y pruebas E2E controladas.
SHARKY_ORCHESTRATOR_LAB_ENABLED=0
# Secreto aleatorio estable (mínimo 32 caracteres) para HMAC de contactos
# y cifrado de inbox/outbox. Obligatorio antes de activar el lab.
SHARKY_CONTACT_HASH_KEY=
# Secreto aleatorio estable y distinto (mínimo 32 caracteres) para cifrar
# el estado conversacional durable. Debe existir tanto en FPM como en workers/cron.
SHARKY_STATE_ENCRYPTION_KEY=

# Recomendado: secreto estable para anonimizar origen/visitante en Historias
# y firmar enlaces de confirmación/cancelación de avisos. Usa una cadena aleatoria larga.
# No cambiarlo sin invalidar los enlaces de avisos que sigan vigentes.
HACHE_PUBLIC_INTERACTION_SALT=
